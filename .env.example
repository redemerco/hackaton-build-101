# Copiar a .env.local (NUNCA se commitea)
GEMINI_API_KEY=
GITHUB_TOKEN=
LINEAR_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:tu-gmail@gmail.com
# OAuth "Conectar GitHub/Linear" (Joaco). Callback: <origen>/api/connect/github|linear/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# OAuth "Conectar Slack" (Joaco). Slack exige callback HTTPS: <dominio-ngrok>/api/connect/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_TEAM_ID=
# Token para lectura de datos por un agente (solo lectura): GET /api/agent/read
AGENT_READ_TOKEN=
# Sin GEMINI_API_KEY, la IA (lib/ai.ts) va por este servicio: el POST /api/ingesta/procesar de un server con key.
# Con GEMINI_API_KEY se ignora. Ej: https://pulso.renzodemarco.com.uy/api/ingesta/procesar
AI_SERVICE_URL=
