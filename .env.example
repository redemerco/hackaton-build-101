# Copiar a .env.local (NUNCA se commitea). Esto es SOLO para correr local.
# En el NAS no hay .env.local: los secretos salen del vault de PiWS (`secrets env pulso`, prefijo pulso/*) y la
# config no secreta del manifiesto de svc (servicios/svc/manifests/pulso.json). Una variable nueva va en los dos lados.
# Origen público de la app (callbacks OAuth, webhook). Local: vacío = el host del request (http://localhost:3000).
APP_URL=
# IA (lib/ai.ts), en este orden: PIWS_AI_URL+PIWS_AI_KEY → ai-service de PiWS (router que rota keys/modelos y cae
# a Groq); si no, GEMINI_API_KEY → Gemini directo; si no, AI_SERVICE_URL → /api/ingesta/procesar de otro server.
# PIWS_AI_URL es la base OpenAI `.../v1`: en el NAS http://127.0.0.1:3211/v1, desde la Mac http://100.121.47.10:3211/v1
PIWS_AI_URL=
PIWS_AI_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=
LINEAR_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:tu-gmail@gmail.com
# OAuth "Conectar GitHub/Linear" (Joaco). Callback: <origen>/api/connect/github|linear/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# OAuth "Conectar Slack" (Joaco). Slack exige callback HTTPS: <dominio-ngrok>/api/connect/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_TEAM_ID=
# Token para lectura de datos por un agente (solo lectura): GET /api/agent/read
AGENT_READ_TOKEN=
# Sin PIWS_AI_* ni GEMINI_API_KEY, la IA (lib/ai.ts) va por este servicio: el POST /api/ingesta/procesar de un server con key.
# Con PIWS_AI_* o GEMINI_API_KEY se ignora. Ej: https://pulso.renzodemarco.com.uy/api/ingesta/procesar
AI_SERVICE_URL=
# Webhook de Google Health (POST /api/webhooks/health). Valor EXACTO del header Authorization que manda Google,
# con el esquema incluido, ej. "Bearer <random>" (openssl rand -hex 32). El mismo que usa scripts/health-subscriber.sh.
HEALTH_WEBHOOK_SECRET=
# Solo pruebas locales: =1 saltea la firma GOOGLE-HEALTH-API-SIGNATURE. NUNCA en el NAS.
# HEALTH_WEBHOOK_SKIP_SIGNATURE=1
# Tiempos y endpoints (opcionales; estos son los defaults de lib/config.ts):
# HEALTH_WEBHOOK_DEBOUNCE_MS=60000     debounce por usuario entre el aviso del webhook y el sync
# HEALTH_SLEEP_FRESH_MS=129600000      sueño "nuevo" (dispara push) si la última noche es de < 36 h
# HEALTH_KEYSET_TTL_MS=21600000        caché del keyset de firmas de Google (6 h)
# SSE_RETRY_MS=5000                    retry del EventSource de /api/events
# SSE_HEARTBEAT_MS=25000               ping SSE para que cloudflared no corte
# HEALTH_API_BASE=https://health.googleapis.com/v4
# HEALTH_KEYSET_URL=https://www.gstatic.com/googlehealthapi/webhooks/webhooks_public_keyset.json
# scripts/health-subscriber.sh: HEALTH_PROJECT_NUMBER (obligatorio) y HEALTH_ENDPOINT (o APP_URL), sin defaults.
# Agente (lib/agent.ts). =1 habilita ESCRIBIR en Google Calendar (mover reuniones, foco, entrenar, descanso, "A dormir").
# Sin esto todo lo de Calendar queda [simulado] con un link para hacerlo a mano. Requiere el scope calendar.events.
CALENDAR_WRITE_OK=
# Token del job de 6 h: POST /api/agent/cron con "Authorization: Bearer <token>" (openssl rand -hex 32).
# Evalúa + propone por usuario y avisa por push; nunca ejecuta acciones.
AGENT_CRON_TOKEN=
# Opcionales del agente (defaults entre paréntesis). Hora = hora de Uruguay.
# AGENT_PROPOSAL_TTL_H=6        vencimiento de una propuesta
# AGENT_QUIET_START=22          sin push desde esta hora…
# AGENT_QUIET_END=8             …hasta esta
# AGENT_SLEEP_GOAL_H=7.5        meta de sueño (deuda semanal y hora de "A dormir" = despertar − meta)
# AGENT_SHORT_SLEEP_H=6         debajo de esto la noche fue corta
# AGENT_AZM_WEEK_GOAL=150       meta semanal de minutos en zona activa
# AGENT_WORK_START=9            semana laboral para el avance esperado (lunes a AGENT_WORK_DAYS)
# AGENT_WORK_END=18
# AGENT_WORK_DAYS=5
# AGENT_BEHIND_PCT=10           puntos de gap para decir atrasado/adelantado
# AGENT_LOG_PROMPT_HOUR=14      desde esta hora, sin ánimo/comidas → recordatorio
# AGENT_TRAINING_HOUR=18        hora preferida del bloque para entrenar
# AGENT_TRAINING_MIN=45
# AGENT_FOCUS_MIN=90
# AGENT_REST_MIN=20
# AGENT_BEDTIME_REMINDER_MIN=30 aviso popup antes de "A dormir"
# AGENT_DAY_END_HOUR=20         nada de trabajo se agenda después
