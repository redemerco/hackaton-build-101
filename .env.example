# Copiar a .env.local (NUNCA se commitea)
# IA (lib/ai.ts), en este orden: PIWS_AI_URL+PIWS_AI_KEY → ai-service de PiWS (router que rota keys/modelos y cae
# a Groq); si no, GEMINI_API_KEY → Gemini directo; si no, AI_SERVICE_URL → /api/ingesta/procesar de otro server.
# PIWS_AI_URL es la base OpenAI `.../v1`: en el NAS http://127.0.0.1:3211/v1, desde la Mac http://100.121.47.10:3211/v1
PIWS_AI_URL=
PIWS_AI_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=
LINEAR_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:tu-gmail@gmail.com
# OAuth "Conectar GitHub/Linear" (Joaco). Callback: <origen>/api/connect/github|linear/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# OAuth "Conectar Slack" (Joaco). Slack exige callback HTTPS: <dominio-ngrok>/api/connect/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_TEAM_ID=
# Token para lectura de datos por un agente (solo lectura): GET /api/agent/read
AGENT_READ_TOKEN=
# Sin PIWS_AI_* ni GEMINI_API_KEY, la IA (lib/ai.ts) va por este servicio: el POST /api/ingesta/procesar de un server con key.
# Con PIWS_AI_* o GEMINI_API_KEY se ignora. Ej: https://pulso.renzodemarco.com.uy/api/ingesta/procesar
AI_SERVICE_URL=
